{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mac-password-manager",
  "version": "0.1.0",
  "identifier": "com.lumingshi.macpasswordmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mac 密码管理器",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
